# Server-side Next.js proxy target. The browser always uses /api/v1.
API_URL=http://127.0.0.1:4000
# Browser-loaded tiles. No prefetch/offline maps. Keep provider attribution visible.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Set NEXT_PUBLIC_MAP_ATTRIBUTION when using a different tile provider.
