# Server-only Fastify origin. Required on Vercel; must be a public HTTPS origin.
API_URL=http://127.0.0.1:4000
# Optional verified account sign-in. Use a public publishable key, never a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Browser-loaded tiles; no prefetch/offline maps.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Configure attribution if you change the tile provider.
# NEXT_PUBLIC_MAP_ATTRIBUTION=
