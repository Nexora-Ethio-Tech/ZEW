NODE_ENV=development
PORT=4000
HOST=127.0.0.1
DATABASE_PATH=./data/zew.sqlite
FRONTEND_ORIGIN=http://localhost:3000
PHOTON_URL=https://photon.komoot.io/api/
# Optional verified account sign-in. Must match the frontend Supabase project.
# These are used only to validate user access tokens, not to mirror SQLite data.
SUPABASE_URL=
SUPABASE_KEY=
# Optional operator-only SMTP setup. Never copy these to frontend/public variables.
# Run: node --env-file=.env scripts/configure-auth-email.mjs
SUPABASE_ACCESS_TOKEN=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME="Zew"
# Optional routing provider. The fallback is illustrative, not real road verification.
# OSRM_URL=
